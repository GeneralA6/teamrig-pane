{
  "name": "teamrig-pane-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for the teamrig-pane Claude Code plugin",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.pane.json",
    "typecheck:pane": "tsc -p tsconfig.pane.json",
    "test": "node --test \"tools/**/*.test.ts\"",
    "scrub": "node tools/scrub/cli.ts --tree",
    "setup": "node tools/setup/cli.ts",
    "coverage": "node tools/ci/coverage-cli.ts",
    "plugin-tests": "node tools/ci/plugin-tests-cli.ts",
    "check": "npm run typecheck && npm run coverage && npm run plugin-tests && npm run scrub",
    "pane-test": "claude plugin test plugins/teamrig-pane"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "5.9.3"
  }
}
